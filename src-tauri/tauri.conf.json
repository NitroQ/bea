{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bea",
  "version": "0.2.0",
  "identifier": "com.bea.meetingassistant",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bea - Your Attentive Meeting Assistant",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/media/**",
          "$APPDATA/derived/**",
          "$APPDATA/recordings/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": [
      "binaries/tesseract"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1N0VBODg2ODE4QjdGNjUKUldSbGY0dUJocWgrcFNMT3pwMkdQSDV5YzAvVmtselZMMjZ2WG5keFRJWEk4QVY3bVNCay9mZ0gK",
      "endpoints": [
        "https://github.com/NitroQ/bea/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
